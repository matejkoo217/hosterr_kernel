menu "OpenHarmony / HarmonyOS userspace support"

config OHOS_DM_PARTNAME
	bool "Report device-mapper device names as PARTNAME in uevents"
	depends on BLK_DEV_DM=y
	default n
	help
	  OpenHarmony init creates /dev/block/by-name links only from the
	  PARTNAME uevent variable. Exposing the dm name lets logical
	  partitions mapped from the Android super partition be found
	  by name (system, vendor, chip_prod, sys_prod, ...).

config OHOS_BRINGUP_NOREBOOT
	bool "Allow refusing HarmonyOS init 'panic' reboots (hmos.noreboot=1)"
	default n

config OHOS_BRINGUP_PERMISSIVE
	bool "Allow forcing SELinux permissive (hmos.permissive=1)"
	depends on SECURITY_SELINUX_DEVELOP
	default n

config OHOS_DRM_AUTH_ALL
	bool "Treat every DRM client as authenticated (HarmonyOS display HALs)"
	depends on DRM
	default n
	help
	  The HarmonyOS allocator host, composer host and render_service are
	  separate non-root processes that share buffers on the primary DRM
	  node through PRIME. There is no Android-style authenticator, so
	  treat every client as authenticated.  KMS still requires DRM master.

config OHOS_FS_EMU
	bool "Emulate hmdfs/sharefs mounts with tmpfs + bind mounts"
	default n
	help
	  HarmonyOS storage_daemon needs the hmdfs and sharefs filesystems to
	  start a user.  Emulate their local (non-distributed) views.

config OHOS_FSVERITY_STUB
	bool "Accept fs-verity / code-sign enable ioctls as no-ops"
	default n
	help
	  Lets HarmonyOS installd install HAPs with native libraries on a
	  kernel without fs-verity or code-sign enforcement.  No integrity is
	  enforced.

config OHOS_MEMCG_FILES
	bool "Accept the HarmonyOS memmgr hyperhold/zswapd memcg files"
	depends on MEMCG
	default n
	help
	  memmgrservice writes memory.name, memory.app_score, memory.zswapd_*
	  ... in /dev/memcg and refuses to start when one of the files is
	  missing.  Store the values and read them back; nothing acts on them.

config OHOS_NFC_SYSFS
	bool "Provide /sys/nfc attributes for the HarmonyOS NFC stack"
	default n
	help
	  Huawei's NFC HAL reads its chip type, device node and configuration
	  file names from /sys/nfc.  Export the same attributes as plain
	  values so the NXP HAL can drive an nq-nci controller.

endmenu
